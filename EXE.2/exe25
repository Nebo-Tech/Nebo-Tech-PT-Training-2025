# Loop through numbers 1 to 10 for which we want multiplication tables
for i in range(1, 11):
    print(f"Multiplication table of: {i}")
    
    # For each number 'i', multiply it by numbers 1 to 10
    for j in range(1, 11):
        product = i * j
        print(product, end=" ")  # Print product on the same line separated by spaces
    
    print("\n")  # Add a line break after each table for clarity